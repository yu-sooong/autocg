# 預設 true：用 data/mock_posts.json，不碰真實 Threads
MOCK_MODE=true

# mock | api | playwright | auto
# auto：有 token 用 API；有 storage state 用 Playwright；否則 mock
DISCOVERY_PROVIDER=mock
SEND_PROVIDER=mock

# 官方 Threads API（可選，第一版不需要）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_BASE=https://graph.threads.com/v1.0

# Queue
QUEUE_DELAY_MS=8000
MAX_DAILY_ACTIONS=20
AUTHOR_COOLDOWN_DAYS=30
QUEUE_CONCURRENCY=1

# Playwright
PLAYWRIGHT_HEADLESS=true

# 可選：Cursor CLI 自動分析（不需要 OpenAI key）
# 若已安裝 `agent` CLI，Dashboard 會顯示額外按鈕
CURSOR_CLI_ENABLED=true
